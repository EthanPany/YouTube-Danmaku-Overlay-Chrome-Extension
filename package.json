{
  "name": "youtube-danmaku-overlay",
  "version": "2.0.0",
  "description": "A Chrome extension that overlays Bilibili danmaku comments on YouTube videos",
  "private": false,
  "scripts": {
    "start": "webpack --mode=development --watch",
    "build": "webpack --mode=production",
    "clean": "rimraf build",
    "test": "jest",
    "eval:match": "jest --testMatch '<rootDir>/scripts/matching.eval.js' --testTimeout 600000",
    "lint": "eslint --ext .js,.jsx src test scripts",
    "lint:fix": "eslint --ext .js,.jsx src test scripts --fix",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\"",
    "prepare": "husky",
    "package": "npm run build && cd build && zip -r ../extension.zip .",
    "eval:align": "jest --testMatch '<rootDir>/scripts/alignment.eval.js' --testTimeout 600000"
  },
  "keywords": [
    "youtube",
    "bilibili",
    "danmaku",
    "chrome-extension",
    "comments",
    "overlay"
  ],
  "author": "Ethan Pan",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/EthanPany/YouTube-Danmaku-Overlay-Chrome-Extension"
  },
  "bugs": {
    "url": "https://github.com/EthanPany/YouTube-Danmaku-Overlay-Chrome-Extension/issues"
  },
  "homepage": "https://github.com/EthanPany/YouTube-Danmaku-Overlay-Chrome-Extension#readme",
  "dependencies": {
    "ajv": "8.12.0",
    "ajv-keywords": "5.1.0",
    "chinese-conv": "^3.2.2",
    "danmaku": "^2.0.8",
    "prop-types": "^15.8.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.23.3",
    "babel-loader": "^9.1.3",
    "copy-webpack-plugin": "11.0.0",
    "css-loader": "^6.10.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "html-webpack-plugin": "^5.6.0",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "prettier": "^3.2.5",
    "rimraf": "^5.0.5",
    "style-loader": "^3.3.4",
    "terser-webpack-plugin": "^5.3.10",
    "webpack": "^5.90.3",
    "webpack-cli": "^5.1.4"
  },
  "engines": {
    "node": ">=14.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^chinese-conv/dist$": "<rootDir>/node_modules/chinese-conv/dist/index.umd.js"
    }
  }
}
